{
  "name": "i18n-screenshot-fonts",
  "version": "0.1.0",
  "description": "Font recommendations for multilingual App Store screenshots and UI. Curated picks for 40+ languages including CJK, Arabic, Hebrew, Thai, Devanagari, and Latin scripts with fallback chains.",
  "keywords": [
    "fonts",
    "typography",
    "i18n",
    "localization",
    "cjk",
    "rtl",
    "arabic",
    "japanese",
    "app-store",
    "screenshots",
    "typescript"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlperenGuntekin/i18n-screenshot-fonts.git"
  },
  "homepage": "https://shotlingo.com",
  "bugs": {
    "url": "https://github.com/AlperenGuntekin/i18n-screenshot-fonts/issues"
  },
  "author": {
    "name": "Alperen Güntekin",
    "url": "https://shotlingo.com"
  },
  "license": "MIT",
  "dependencies": {
    "app-store-locales": "^0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
